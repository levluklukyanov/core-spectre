<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!-- DESIGN TOKENS (Pure Monochrome: Light & Dark)                -->
    <!-- ============================================================ -->

    <!-- Surfaces (Warm, calm, pleasant to the eyes) -->
    <Color x:Key="ColorBgBase">#F8F9FA</Color>
    <Color x:Key="ColorBgSurface">#FFFFFF</Color>
    <Color x:Key="ColorBgSurfaceHover">#F1F2F5</Color>
    <Color x:Key="ColorBgInner">#F3F4F6</Color>
    <Color x:Key="ColorBgElevated">#FFFFFF</Color>
    <Color x:Key="ColorBgButton">#EAECEF</Color>
    <Color x:Key="ColorBgButtonHover">#DFE2E6</Color>

    <!-- Borders -->
    <Color x:Key="ColorBorder">#E5E7EB</Color>
    <Color x:Key="ColorBorderCard">#E5E7EB</Color>
    <Color x:Key="ColorBorderHover">#D1D5DB</Color>
    <Color x:Key="ColorBorderButton">#D1D5DB</Color>
    <Color x:Key="ColorBorderSubtle">#ECEFF1</Color>

    <!-- Typography -->
    <Color x:Key="ColorTextPrimary">#1F2328</Color>
    <Color x:Key="ColorTextSecondary">#59636E</Color>
    <Color x:Key="ColorTextMuted">#8C959F</Color>
    <Color x:Key="ColorTextDark">#FFFFFF</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="BrushBgBase" Color="{StaticResource ColorBgBase}"/>
    <SolidColorBrush x:Key="BrushBgSurface" Color="{StaticResource ColorBgSurface}"/>
    <SolidColorBrush x:Key="BrushBgSurfaceHover" Color="{StaticResource ColorBgSurfaceHover}"/>
    <SolidColorBrush x:Key="BrushBgInner" Color="{StaticResource ColorBgInner}"/>
    <SolidColorBrush x:Key="BrushBgElevated" Color="{StaticResource ColorBgElevated}"/>
    <SolidColorBrush x:Key="BrushBgButton" Color="{StaticResource ColorBgButton}"/>
    <SolidColorBrush x:Key="BrushBgButtonHover" Color="{StaticResource ColorBgButtonHover}"/>

    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="BrushBorderCard" Color="{StaticResource ColorBorderCard}"/>
    <SolidColorBrush x:Key="BrushBorderHover" Color="{StaticResource ColorBorderHover}"/>
    <SolidColorBrush x:Key="BrushBorderButton" Color="{StaticResource ColorBorderButton}"/>
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}"/>

    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="BrushTextDark" Color="{StaticResource ColorTextDark}"/>

    <!-- Global Typography Smoothing -->
    <Style TargetType="TextBlock">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
    </Style>

