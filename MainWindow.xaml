<Window x:Class="CoreSpectre.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CoreSpectre.Views"
        Title="CoreSpectre" 
        Icon="Assets/Icons/app.ico"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Height="720" Width="1080"
        MinWidth="920" MinHeight="600"
        Background="{DynamicResource BrushBgBase}"
        FontFamily="{DynamicResource FontMain}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="48"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- 1. HEADER / TITLEBAR                                         -->
        <!-- ============================================================ -->
        <Border x:Name="BackgroundHeader" Grid.Row="0" Background="{DynamicResource BrushBgBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <!-- Brand -->
                    <ColumnDefinition Width="220"/>
                    <!-- Unified Status Chip Bar (Draggable) -->
                    <ColumnDefinition Width="*"/>
                    <!-- Actions & Window Caption Buttons -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="BrandLogoImage" Source="Assets/Icons/logo.png" Width="18" Height="18" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <TextBlock Text="CoreSpectre" FontWeight="SemiBold" FontSize="14.5" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Live System Telemetry -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- CPU -->
                    <StackPanel x:Name="QuickCpuMetric" Orientation="Horizontal" Cursor="Hand" MouseLeftButtonDown="CpuMetric_Click" ToolTip="Switch to CPU Optimization tab">
                        <Path Data="{StaticResource IconCpu}" Width="12" Height="12" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="CPU " FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QuickCpuText" Text="--" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Separator Dot -->
                    <Ellipse Width="3" Height="3" Fill="{DynamicResource BrushTextMuted}" Margin="10,0" VerticalAlignment="Center"/>

                    <!-- RAM -->
                    <StackPanel x:Name="QuickRamMetric" Orientation="Horizontal" Cursor="Hand" MouseLeftButtonDown="RamMetric_Click" ToolTip="Switch to Memory Purge tab">
                        <Path Data="{StaticResource IconRam}" Width="12" Height="12" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="RAM " FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QuickRamText" Text="--" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Separator Dot -->
                    <Ellipse Width="3" Height="3" Fill="{DynamicResource BrushTextMuted}" Margin="10,0" VerticalAlignment="Center"/>

                    <!-- Drive C (Clickable -> Opens Windows Explorer) -->
                    <StackPanel x:Name="QuickDiskMetric" Orientation="Horizontal" Cursor="Hand" MouseLeftButtonDown="DiskMetric_Click" ToolTip="Open Drive in Windows Explorer">
                        <Path Data="{StaticResource IconHardDrive}" Width="12" Height="12" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QuickDiskLabel" Text="Drive C: " FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QuickDiskText" Text="--" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Separator Dot -->
                    <Ellipse Width="3" Height="3" Fill="{DynamicResource BrushTextMuted}" Margin="10,0" VerticalAlignment="Center"/>

                    <!-- Game Mode Indicator -->
                    <StackPanel x:Name="GameModeIndicatorPanel" Orientation="Horizontal" Cursor="Hand" MouseLeftButtonDown="GameModeIndicator_Click" ToolTip="Open Game Mode">
                        <Path Data="{StaticResource IconGamepad}" Width="12" Height="12" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <Ellipse x:Name="GameModeDot" Width="5" Height="5" Fill="{DynamicResource BrushTextMuted}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GameModeText" Text="Waiting for games" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions & Window Caption Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleHud" Style="{StaticResource BtnGhostTitlebar}" Click="BtnToggleHud_Click" Margin="0,0,10,0" ToolTip="Toggle compact floating HUD overlay">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconPictureInPicture}" Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="HUD" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Separator Width="1" Height="16" Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,6,0" VerticalAlignment="Center"/>

                    <!-- Window Caption Buttons -->
                    <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Style="{StaticResource WinCaptionButton}" ToolTip="Minimize">
                        <Path Data="M 0,5 H 10 V 6 H 0 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Style="{StaticResource WinCaptionButton}" ToolTip="Maximize">
                        <Path Data="M 0,0 H 9 V 9 H 0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Fill="Transparent" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="BtnClose" Click="BtnClose_Click" Style="{StaticResource WinCloseButton}" ToolTip="Close">
                        <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 2. BODY: SIDEBAR NAV + CONTENT WORKSPACE                     -->
        <!-- ============================================================ -->
        <Grid x:Name="BackgroundWorkspace" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Modern Fixed Width Sidebar -->
                <ColumnDefinition Width="220"/>
                <!-- Main Workspace -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="{DynamicResource BrushBgBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
                <Grid Margin="12,16">
                    <StackPanel>
                        <TextBlock x:Name="NavHeaderTitle" Text="NAVIGATION" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="12,0,0,12"/>
                        <StackPanel x:Name="NavPillsContainer"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN CONTENT WORKSPACE -->
            <Grid Grid.Column="1" Margin="28,22">
                <views:OverviewView x:Name="ViewOverview" Visibility="Visible"/>
                <views:PurgeView x:Name="ViewPurge" Visibility="Collapsed"/>
                <views:StorageView x:Name="ViewStorage" Visibility="Collapsed"/>
                <views:GamesView x:Name="ViewGames" Visibility="Collapsed"/>
                <views:SettingsView x:Name="ViewSettings" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <!-- ============================================================ -->
        <!-- 3. FOOTER STATUS BAR                                         -->
        <!-- ============================================================ -->
        <Border x:Name="BackgroundFooter" Grid.Row="2" Background="{DynamicResource BrushBgBase}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusFooterText" Text="" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconClock}" Width="12" Height="12" Fill="{DynamicResource BrushTextMuted}" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FooterClockText" Text="--:--:-- (UTC+0)" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 4. MODERN MODAL CONFIRMATION DIALOG OVERLAY                  -->
        <!-- ============================================================ -->
        <Grid x:Name="ModernModalOverlay" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="9999" Background="#CC0A0D14" KeyboardNavigation.TabNavigation="Cycle">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource BrushBgSurface}"
                    BorderBrush="{DynamicResource BrushBorderCard}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Width="440"
                    Padding="26,24"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Icon Circle Badge -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource BrushBgElevated}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Path x:Name="ModalIconPath" Data="{StaticResource IconInfo}" Width="18" Height="18" Fill="{DynamicResource BrushTextPrimary}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                             <TextBlock x:Name="ModalDialogTitle" Text="Подтверждение" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ModalDialogSub" Text="Действие требует подтверждения" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="ModalDialogMessage" Text="Вы уверены, что хотите выполнить это действие?" FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,24"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" x:Name="BtnModalCancel" Style="{StaticResource BtnPill}" Content="Отмена" Padding="18,8" Margin="0,0,10,0" Click="BtnModalCancel_Click"/>
                        <Button Grid.Column="2" x:Name="BtnModalConfirm" Style="{StaticResource BtnPrimaryWhite}" Content="Подтвердить" Padding="20,8" Click="BtnModalConfirm_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
